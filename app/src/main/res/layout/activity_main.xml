<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/layout_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- WebView -->
        <WebView
            android:id="@+id/webview"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Экран загрузки (Splash) -->
        <RelativeLayout
            android:id="@+id/layout_splash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:background="#80000000">

            <!-- Фоновый градиент -->
            <View
                android:id="@+id/view_splash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_splash_gradient" />

            <!-- Логотип -->
            <ImageView
                android:id="@+id/app_logo"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo"
                android:layout_marginTop="139dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true" />

            <!-- Название приложения -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:layout_below="@+id/app_logo"
                android:layout_marginTop="20dp"
                android:textSize="24dp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>

        <!-- Экран "Нет интернета" -->
        <RelativeLayout
            android:id="@+id/layout_no_internet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#80000000">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha=".90"
                android:background="@drawable/bg_splash_gradient" />

            <!-- Иконка предупреждения -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_no_internet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:layout_marginTop="139dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                app:srcCompat="@drawable/ic_warning" />

            <!-- Заголовок -->
            <TextView
                android:id="@+id/txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Whoops!"
                android:layout_below="@+id/img_no_internet"
                android:layout_marginTop="20dp"
                android:textSize="35dp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_centerHorizontal="true"/>

            <!-- Описание -->
            <TextView
                android:id="@+id/txt_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_title"
                android:layout_marginTop="20dp"
                android:textSize="18dp"
                android:textColor="#FFFFFF"
                android:layout_centerHorizontal="true"
                android:textAlignment="center"
                android:text="Нет подключения к интернету.\nПроверьте соединение или попробуйте снова"/>

            <!-- Кнопка "Попробовать снова" -->
            <Button
                android:id="@+id/btn_try_again"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:layout_centerHorizontal="true"
                android:layout_below="@+id/txt_detail"
                android:background="@drawable/bg_button_gradient"
                android:textColor="#FFFFFF"
                android:text="Попробовать снова"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

        </RelativeLayout>

        <!-- Прогресс бар -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:layout_centerHorizontal="true"
            android:visibility="visible"
            android:progressDrawable="@drawable/cs_custom_progressbar"
            style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal" />

    </RelativeLayout>

</RelativeLayout>
